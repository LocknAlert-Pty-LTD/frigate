{"nodes": [{"id": "test_test_post_processing_nms_box_format", "label": "NMS box format regression suite", "file_type": "rationale", "source_file": "frigate/test/test_post_processing.py", "source_location": "1-14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cv2.dnn.NMSBoxes expects [x, y, width, height]; passing corner coordinates makes OpenCV read x2/y2 as width/height, inflating every box toward the bottom-right proportional to its distance from the origin. Two well separated objects far from the origin then appear to overlap (IoU 0.465 > 0.4 threshold) and the lower scoring one is silently suppressed. Fixed geometry A=(393,499,484,620) B=(527,499,618,620) at 640x640 pins the bug across every detector post-processor."}, {"id": "test_test_post_processing_testyolonmspostprocess", "label": "TestYoloNmsPostProcess", "file_type": "code", "source_file": "frigate/test/test_post_processing.py", "source_location": "48", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "test_test_post_processing_testmultipartyolopostprocess", "label": "TestMultipartYoloPostProcess", "file_type": "code", "source_file": "frigate/test/test_post_processing.py", "source_location": "85", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "test_test_post_processing_testyoloxpostprocess", "label": "TestYoloxPostProcess", "file_type": "code", "source_file": "frigate/test/test_post_processing.py", "source_location": "131", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "test_test_post_processing_testdfinepostprocess", "label": "TestDfinePostProcess", "file_type": "code", "source_file": "frigate/test/test_post_processing.py", "source_location": "151", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "test_test_post_processing_testrfdetrpostprocess", "label": "TestRfdetrPostProcess", "file_type": "code", "sour