{"nodes": [{"id": "utils_cameraclone_stripautodefaultfilters", "label": "stripAutoDefaultFilters", "file_type": "code", "source_file": "web/src/utils/cameraClone.ts", "source_location": "62-132", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reduces each filter entry to only the fields that differ from the backend's auto-populated default, so cloning does not copy an auto-default onto every other label; runtime-only mask/raw_mask fields are stripped before comparison since the API always includes them as {}."}, {"id": "utils_cameraclone_stripdictentryfields", "label": "stripDictEntryFields", "file_type": "code", "source_file": "web/src/utils/cameraClone.ts", "source_location": "139-157", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "utils_cameraclone_extractfiltermasks", "label": "extractFilterMasks", "file_type": "code", "source_file": "web/src/utils/cameraClone.ts", "source_location": "164-190", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "utils_cameraclone_stripresetmarkers", "label": "stripResetMarkers", "file_type": "code", "source_file": "web/src/utils/cameraClone.ts", "source_location": "196-209", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drops \"\" (Reset) markers before submitting a new-camera payload: they are meaningless for a camera that doesn't exist yet and the backend's update_yaml would raise KeyError trying to delete a key that was never set."}, {"id": "utils_cameraclone_bundlenewcamerapayload", "label": "bundleNewCameraPayload", "file_type": "code", "source_file": "web/src/utils/cameraClone.ts", "source_location": "216-238", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collapses per-section payloads into a single camera-level '.../add' PUT so the backend's add handler validates the whole camera atomically, avoiding a per-section ordering problem (e.g. review.required_zones referencing zones not yet written)."}, {"id": "utils_cameraclone_cleanupffmpeginputargs", "label": "cleanupFfmpegInputArgs", "file_type": "code", "source_file": "web/src/utils/cameraClone.ts", "source_location": "244-264", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "utils_cameraclone_rawcamerapaths", "label": "RawCameraPaths", "file_type": "code", "source_file": "web/src/utils/cameraClone.ts", "source_location": "267-272", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "utils_cameraclone_restoreffmpegpaths", "label": "restoreFfmpegPaths", "file_type": "code", "source_file": "web/src/utils/cameraClone.ts", "source_location": "278-295", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/api/config masks user:pass credentials as *:*; the backend only restores real credentials for existing cameras, so new-camera cloning must unmask them client-side from /api/config/raw_paths."}, {"id": "utils_cameraclone_applydetectcomputeddefaults", "label": "applyDetectComputedDefaults", "file_type": "code", "source_file": "web/src/utils/cameraClone.ts", "source_location": "302-329", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replays the backend's per-camera detect-field derivation formulas (min_initialized, max_disappeared, stationary threshold/interval) on the synthetic new-camera baseline so the source's already-computed values cancel out of the diff, since the global config has no per-camera derivation to compare against."}, {"id": "utils_cameraclone_clonecategorykey", "label": "CloneCategoryKey", "file_type": "code", "source_file": "web/src/utils/cameraClone.ts", "source_location": "339-362", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "utils_cameraclone_clone_categories", "label": "CLONE_CATEGORIES", "file_type": "code", "source_file": "web/src/utils/cameraClone.ts", "source_location": "377-410", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "utils_cameraclone_resolutionsmatch", "label": "resolutionsMatch", "file_type": "code", "source_file": "web/src/utils/cameraClone.ts", "source_location": "416-436", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires exact detect width/height match rather than aspect-ratio tolerance, because zone/mask coordinates may be stored as explicit pixel values rather than 0-1 relative fractions, so approximate matches would silently misplace them."}, {"id": "utils_cameraclone_getcategorydefaults", "label": "getCategoryDefaults", "file_type": "code", "source_file": "web/src/utils/cameraClone.ts", "source_location": "444-453", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing-camera clone targets start with no categories selected because copying onto an already-configured camera is destructive; only new-camera targets pre-select the defaultOnExisting/forcedForNewCamera categories."}, {"id": "utils_cameraclone_buildclonedcamerapayloads", "label": "buildClonedCameraPayloads", "file_type": "code", "source_file": "web/src/utils/cameraClone.ts", "source_location": "472-826", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "utils_cameraclone_buildclonepreviewitems", "label": "buildClonePreviewItems", "file_type": "code", "source_file": "web/src/utils/cameraClone.ts", "source_location": "832-856", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "utils_cameraclone_buildclonedcamerapayloads", "target": "utils_camerautil_processcameraname", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "web/src/utils/cameraClone.ts", "source_location": "485", "weight": 1.0}, {"source": "utils_cameraclone_buildclon