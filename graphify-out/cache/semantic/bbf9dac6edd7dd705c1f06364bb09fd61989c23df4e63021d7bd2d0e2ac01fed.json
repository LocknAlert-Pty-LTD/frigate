location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without a well-populated 'none' class the classifier has no 'I don't know' option, so every unknown runtime crop is forced into a real class. Target a count comparable to the other classes, images at least 100x100, and visual variety. Class balance skew above 3x also lets the dominant class absorb borderline predictions."}], "edges": [{"source": "testing_scripts_object_dataset_main", "target": "testing_scripts_object_dataset_load_tflite", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "testing-scripts/object_dataset.py", "source_location": null, "weight": 1.0}, {"source": "testing_scripts_object_dataset_main", "target": "testing_scripts_object_dataset_load_labelmap", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "testing-scripts/object_dataset.py", "source_location": null, "weight": 1.0}, {"source": "testing_scripts_object_dataset_main", "target": "testing_scripts_object_dataset_classify_dataset", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "testing-scripts/object_dataset.py", "source_location": null, "weight": 1.0}, {"source": "testing_scripts_object_dataset_main", "target": "testing_scripts_object_dataset_classify_folder", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "testing-scripts/object_dataset.py", "source_location": null, "weight": 1.0}, {"source": "testing_scripts_object_dataset_main", "target": "testing_scripts_object_dataset_summarize_dataset", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "testing-scripts/object_dataset.py", "source_location": null, "weight": 1.0}, {"source": "testing_scripts_object_dataset_main", "target": "testing_scripts_object_dataset_confusion_matrix", "relation": "calls", "confidence": "EXTRACTED", "confidence_score"