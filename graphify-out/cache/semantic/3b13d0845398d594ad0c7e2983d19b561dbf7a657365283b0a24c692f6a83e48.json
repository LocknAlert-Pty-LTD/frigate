{"nodes": [{"id": "test_test_profiles_testcameraprofileconfig", "label": "TestCameraProfileConfig", "file_type": "code", "source_file": "frigate/test/test_profiles.py", "source_location": "16", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "test_test_profiles_testprofileinconfig", "label": "TestProfileInConfig", "file_type": "code", "source_file": "frigate/test/test_profiles.py", "source_location": "318", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "test_test_profiles_testprofilemanager", "label": "TestProfileManager", "file_type": "code", "source_file": "frigate/test/test_profiles.py", "source_location": "412", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "test_test_profiles_testprofilepersistence", "label": "TestProfilePersistence", "file_type": "code", "source_file": "frigate/test/test_profiles.py", "source_location": "923", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "test_test_profiles_two_phase_profile_activation", "label": "Two-phase profile activation", "file_type": "rationale", "source_file": "frigate/test/test_profiles.py", "source_location": "788-878", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apply_profile_to_config mutates config only (no ZMQ, MQTT, or disk writes) because workers are started with the corrected values; activate_profile owns the bookkeeping and broadcast. Re-deriving the same state must still publish every section, because processes started before the config was corrected have no other channel. Startup replays pass clear_runtime_overrides=False so runtime overrides layered on top survive, and a config/set save relies on clear_runtime_state_for_yaml_keys instead of a broad wipe that would drop overrides for unrelated cameras. Profile changes also republish retained MQTT switch states so Home Assistant does not show a stale toggle."}, {"id": "test_test_profiles_profile_override_base_validation", "label": "Profile overrides must reference existing base entities", "file_type": "rationale", "source_file": "frigate/test/test_profiles.py", "source_location": "182-264", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A profile may only override zones and motion masks that exist on the base camera, and may only reference profiles declared at the top level; phantom names are rejected at parse time rather than silently creating new entities at activation."}], "edges": [{"source": "test_test_profiles_testcameraprofileconfig", "target": "camera_profile_cameraprofileconfig", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/test/test_profiles.py", "source_location": "21", "weight": 1.0}, {"source": "test_test_profiles_testcameraprofileconfig", "target": "config_config_frigateconfig", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/test/test_profiles.py", "source_location": "149", "weight": 1.0}, {"source": "test_test_profiles_testprofileinconfig", "target": "config_config_frigateconfig", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/test/test_profiles.py", "source_location": "374", "weight": 1.0}, {"source": "test_test_profiles_testprofilemanager", "target": "config_profile_manager_profilemanager", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/test/test_profiles.py", "source_location": "470", "weight": 1.0}, {"source": "test_test_profiles_testprofilepersistence", "target": "config_profile_manager_profilemanager", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/test/test_profiles.py", "source_location": "934", "weight": 1.0}, {"source": "config_profile_manager_profilemanager", "target": "camera_profile_cameraprofilec