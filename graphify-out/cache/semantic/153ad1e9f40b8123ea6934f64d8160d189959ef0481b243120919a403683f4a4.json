{"nodes": [{"id": "frigate_camera_setup", "label": "Camera Setup", "file_type": "document", "source_file": "docs/docs/frigate/camera_setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frigate_camera_setup_stream_roles", "label": "Detect, Record and Stream Roles", "file_type": "concept", "source_file": "docs/docs/frigate/camera_setup.md", "source_location": "Camera setup", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the detect stream is decoded for processing, so tuning resolution and fps at the camera avoids wasting CPU decoding frames Frigate immediately discards; matching aspect ratios across streams keeps live and playback seamless."}, {"id": "frigate_camera_setup_detect_resolution", "label": "Choosing a Detect Resolution", "file_type": "rationale", "source_file": "docs/docs/frigate/camera_setup.md", "source_location": "Choosing a detect resolution", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frigate crops a motion region and resizes it to the model's 320x320 input, so extra resolution is lost in the resize and only helps when objects are very small in the frame."}, {"id": "frigate_camera_setup_detect_fps", "label": "Choosing a Detect Frame Rate", "file_type": "rationale", "source_file": "docs/docs/frigate/camera_setup.md", "source_location": "Choosing a detect frame rate", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tracking matches bounding boxes between detection frames, and 5 fps already yields ~15 detections for an object visible several seconds; raising it scales detection load linearly with no tracking benefit unless an object crosses the whole frame in under two seconds, where camera placement is the real fix."}], "edges": [{"source": "frigate_camera_setup", "target": "frigate_camera_setup_stream_roles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/frigate/camera_setup.md", "source_location": "Camera setup", "weight": 1.0}, {"source": "frigate_camera_setup", "target": "frigate_camera_setup_detect_resolution", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/frigate/camera_setup.md", "source_location": "Choosing a detect resolution", "weight": 1.0}, {"source": "frigate_camera_setup", "target": "frigate_camera_setup_detect_fps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/frigate/camera_setup.md", "source_location": "Choosing a detect frame rate", "weight": 1.0}, {"source": "frigate_camera_setup_detect_resolution", "target": "frigate_glossary_region", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/docs/frigate/camera_setup.md", "source_location": "crops an area of motion and resizes to 320x320", "weight": 1.0}, {"source": "frigate_camera_setup_detect_resolution", "target": "custom_classification_object_classification_crop_size", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/docs/frigate/camera_setup.md", "source_location": "both explain that upscaling a small crop to a fixed model input destroys usable detail", "weight": 1.0}, {"source": "frigate_camera_setup_detect_fps", "target": "frigate_hardware_cpu_vs_detector", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/docs/frigate/camera_setup.md", "source_location": "detection load scales directly with frame rate", "weight": 1.0}], "hyperedges": []}