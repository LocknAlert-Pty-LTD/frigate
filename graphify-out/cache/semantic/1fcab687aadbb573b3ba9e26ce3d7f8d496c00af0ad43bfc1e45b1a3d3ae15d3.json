{"nodes": [{"id": "configuration_audio_detectors_audio_events", "label": "Audio Event Detection", "file_type": "document", "source_file": "docs/docs/configuration/audio_detectors.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "configuration_audio_detectors_min_volume", "label": "Minimum Audio Volume Gate", "file_type": "rationale", "source_file": "docs/docs/configuration/audio_detectors.md", "source_location": "Configuring Minimum Volume", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audio detection only runs above min_volume RMS so the CPU cost mirrors how motion gates object detection; volume above the threshold also counts as motion for recording retention."}, {"id": "configuration_audio_detectors_audio_transcription", "label": "Audio Transcription", "file_type": "rationale", "source_file": "docs/docs/configuration/audio_detectors.md", "source_location": "Audio Transcription", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transcription is user-initiated rather than automatic because it is serialized one event at a time and a queue would need backpressure, prioritization, buffering, retry and crash recovery for little practical value on edge hardware; live transcription is not reused for speech events because the two processes are asynchronous and cannot be aligned reliably."}], "edges": [{"source": "configuration_audio_detectors_audio_events", "target": "configuration_audio_detectors_min_volume", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/audio_detectors.md", "source_location": "Configuring Minimum Volume", "weight": 1.0}, {"source": "configuration_audio_detectors_audio_transcription", "target": "configuration_audio_detectors_audio_events", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, 