{"nodes": [{"id": "custom_classification_state_classification", "label": "State Classification", "file_type": "document", "source_file": "docs/docs/configuration/custom_classification/state_classification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "custom_classification_state_classification_crop_region", "label": "Normalized Camera Crop Region", "file_type": "concept", "source_file": "docs/docs/configuration/custom_classification/state_classification.md", "source_location": "Configuration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Crop coordinates are fractions of the camera's detect width/height rather than pixels so a crop stays valid independent of detect resolution; a tight crop avoids extra signals unrelated to the state."}, {"id": "custom_classification_state_classification_state_verification", "label": "Consecutive State Verification", "file_type": "rationale", "source_file": "docs/docs/configuration/custom_classification/state_classification.md", "source_location": "Debugging Classification Models", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A pending state change requires 3 consecutive identical classifications before it is published, preventing the published state from flipping on a single noisy frame."}, {"id": "custom_classification_state_classification_recent_save_policy", "label": "Recent Classifications Save Policy", "file_type": "rationale", "source_file": "docs/docs/configuration/custom_classification/state_classification.md", "source_location": "Recent Classifications", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Images are only stored on first detection, state changes, pending verification, or sub-100% scores; stable 100% matches are skipped to avoid storing redundant high-confidence classifications."}, {"id": "custom_classification_state_classification_diversity_over_volume", "label": "State Model Diversity Over Volume", "file_type": "rationale", "source_file": "docs/docs/configuration/custom_classification/state_classification.md", "source_location": "Improving the Model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Homogeneous training data yields models that work under the original conditions but destabilize when day turns to night or seasons shift, which is why bulk training is not offered in the UI."}], "edges": [{"source": "custom_classification_state_classification", "target": "frigate_network_requirements_model_cache", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/custom_classification/state_classification.md", "source_location": "info callout linking /frigate/network_requirements#one-time-model-downloads", "weight": 1.0}, {"source": "custom_classification_state_classification", "target": "custom_classification_state_classification_crop_region", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/custom_classification/state_classification.md", "source_location": "Configuration", "weight": 1.0}, {"source": "custom_classification_state_classification", "target": "custom_classification_state_classification_state_verification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/custom_classification/state_classification.md", "source_location": "Debugging Classification Models", "weight": 1.0}, {"source": "custom_classification_state_classification", "target": "custom_classification_state_classification_recent_save_policy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/custom_classification/state_classification.md", "source_location": "Recent Classifications", "weight"