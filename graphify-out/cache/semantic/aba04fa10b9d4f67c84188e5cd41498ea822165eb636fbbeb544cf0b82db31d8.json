{"nodes": [{"id": "frigate_hardware", "label": "Recommended Hardware", "file_type": "document", "source_file": "docs/docs/frigate/hardware.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frigate_hardware_detector", "label": "Object Detection Accelerator (Detector)", "file_type": "concept", "source_file": "docs/docs/frigate/hardware.md", "source_location": "Detectors", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frigate is designed around very low inference times; offloading TensorFlow to a detector is an order of magnitude faster and dramatically reduces CPU load, so the CPU only screens for motion and hands regions to the accelerator."}, {"id": "frigate_hardware_coral", "label": "Google Coral EdgeTPU", "file_type": "concept", "source_file": "docs/docs/frigate/hardware.md", "source_location": "Google Coral TPU", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No longer recommended for new installs except in low-power deployments, but still supported because it remains one of the most power-efficient devices for running detection models."}, {"id": "frigate_hardware_hailo8", "label": "Hailo-8 / Hailo-8L", "file_type": "concept", "source_file": "docs/docs/frigate/hardware.md", "source_location": "Hailo-8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frigate_hardware_openvino", "label": "OpenVINO Detector", "file_type": "concept", "source_file": "docs/docs/frigate/hardware.md", "source_location": "OpenVINO - Intel", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frigate_hardware_memryx_mx3", "label": "MemryX MX3", "file_type": "concept", "source_file": "docs/docs/frigate/hardware.md", "source_location": "MemryX MX3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Being a pipelined architecture, its camera capacity cannot be derived from 1/latency, so the separately measured MX3 Total FPS column is the correct sizing metric."}, {"id": "frigate_hardware_apple_silicon", "label": "Apple Silicon Detector", "file_type": "concept", "source_file": "docs/docs/frigate/hardware.md", "source_location": "Apple Silicon", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Apple Silicon cannot run inside a container, so a ZMQ proxy bridges to a host-side detector process, adding minimal latency only when run on the same device."}, {"id": "frigate_hardware_rockchip_rknn", "label": "Rockchip RKNN", "file_type": "concept", "source_file": "docs/docs/frigate/hardware.md", "source_location": "Rockchip platform", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frigate_hardware_cpu_vs_detector", "label": "CPU Motion Screening vs Detector Inference", "file_type": "rationale", "source_file": "docs/docs/frigate/hardware.md", "source_location": "What does Frigate use the CPU for", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The CPU watches for movement and only forwards those frames to the detector, keeping one accelerator available to many cameras; raising resolution or frame rate increases work for both the decoder and the detector."}], "edges": [{"source": "development_contributing_boards", "target": "frigate_hardware_memryx_mx3", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/docs/frigate/hardware.md", "source_location": "Community Supported Detectors badge", "weight": 1.0}, {"source": "development_contributing_boards", "target": "frigate_hardware_rockchip_rknn", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/docs/frigate/hardware.md", "source_location": "Rockchip marked with CommunityBadge", "weight": 1.0}, {"source"