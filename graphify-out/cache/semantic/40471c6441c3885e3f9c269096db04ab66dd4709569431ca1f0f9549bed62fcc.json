{"nodes": [{"id": "camera_maintainer_cameramaintainer", "label": "CameraMaintainer", "file_type": "code", "source_file": "frigate/camera/maintainer.py", "source_location": "L28-328", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "camera_maintainer_run", "label": "CameraMaintainer.run (process lifecycle loop)", "file_type": "code", "source_file": "frigate/camera/maintainer.py", "source_location": "L245-328", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "camera_maintainer_replay_camera_recycle", "label": "Replay Camera Recycle on Config Refresh", "file_type": "rationale", "source_file": "frigate/camera/maintainer.py", "source_location": "L286-317", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only replay cameras are recycled on a refresh update so detect width/height/fps propagate through ffmpeg args, SHM sizing, and the region grid; regular cameras still require a full Frigate restart for a detect change."}, {"id": "camera_maintainer_unlink_camera_frame_slots", "label": "Deferred SHM Frame Slot Unlink", "file_type": "rationale", "source_file": "frigate/camera/maintainer.py", "source_location": "L209-226", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unlinking the per-frame YUV segments is only safe after the capture/processor subprocesses are joined, since they no longer hold mappings; other long-lived processes keep their existing mappings until frame_manager.get sees a shape that no longer fits and reopens the stale ref."}], "edges": [{"source": "camera_maintainer_cameramaintainer", "target": "camera___init___camerametrics", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/camera/maintainer.py", "source_location": "L119, L161, L189, L243", "weight": 1.0}, {"source": "camera_maintainer_cameramaintainer", "target": "camera___init___ptzme