{"nodes": [{"id": "api_chat_get_tools", "label": "get_tools", "file_type": "code", "source_file": "frigate/api/chat.py", "source_location": "L82-92", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_chat_chat_completion", "label": "chat_completion", "file_type": "code", "source_file": "frigate/api/chat.py", "source_location": "L1125-1450", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The system message is generated only on the first turn and returned in the message chain so the client replays it verbatim, freezing its timestamp to keep the prompt prefix byte-identical and the model server's prompt cache hitting."}, {"id": "api_chat_execute_tool", "label": "execute_tool (/chat/execute)", "file_type": "code", "source_file": "frigate/api/chat.py", "source_location": "L523-562", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_chat_execute_tool_internal", "label": "_execute_tool_internal", "file_type": "code", "source_file": "frigate/api/chat.py", "source_location": "L720-781", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_chat_execute_pending_tools", "label": "_execute_pending_tools", "file_type": "code", "source_file": "frigate/api/chat.py", "source_location": "L1006-1113", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "get_live_context results carry an _image_url that is popped and re-injected as a user message, because images cannot be sent inside tool-result messages."}, {"id": "api_chat_execute_search_objects", "label": "_execute_search_objects", "file_type": "code", "source_file": "frigate/api/chat.py", "source_location": "L141-231", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_chat_execute_search_objects_semantic", "label": "_execute_search_objects_semantic", "file_type": "code", "source_file": "frigate/api/chat.py", "source_location": "L234-349", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_chat_execute_find_similar_objects", "label": "_execute_find_similar_objects", "file_type": "code", "source_file": "frigate/api/chat.py", "source_location": "L352-515", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_chat_candidate_then_filter", "label": "Candidate-then-filter vector search pattern", "file_type": "rationale", "source_file": "frigate/api/chat.py", "source_location": "L421-425", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Event ids are deliberately not passed into the sqlite-vec queries because the IN filter is broken in the installed version. Instead the top-k rows are fetched globally per modality and then intersected with the structured Peewee filters, the same pattern used by events_search."}, {"id": "api_chat_execute_get_live_context", "label": "_execute_get_live_context", "file_type": "code", "source_file": "frigate/api/chat.py", "source_location": "L565-637", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_chat_get_live_frame_image_url", "label": "_get_live_frame_image_url", "file_type": "code", "source_file": "frigate/api/chat.py", "source_location": "L640-677", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_chat_execute_set_camera_state", "label": "_execute_set_camera_state", "file_type": "code", "source_file": "frigate/api/chat.py", "source_location": "L680-717", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_chat_execute_start_camera_watch", "label": "_execute_start_camera_watch", "file_type": "code", "source_file": "frigate/api/chat.py", "source_location": "L784-834", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_chat_execute_stop_camera_wat