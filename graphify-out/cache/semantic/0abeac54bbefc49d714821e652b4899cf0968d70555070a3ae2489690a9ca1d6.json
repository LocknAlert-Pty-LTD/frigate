{"nodes": [{"id": "genai_config", "label": "Configuring Generative AI", "file_type": "document", "source_file": "docs/docs/configuration/genai/config.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "genai_config_provider_roles", "label": "GenAI Provider Roles", "file_type": "concept", "source_file": "docs/docs/configuration/genai/config.md", "source_location": "Configuration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "genai is a map of named providers where each role (chat, descriptions, embeddings) is assigned to exactly one provider, so roles can be split across specialized backends or served by a single provider."}, {"id": "genai_config_embeddings_model", "label": "Embeddings Role Model Requirement", "file_type": "rationale", "source_file": "docs/docs/configuration/genai/config.md", "source_location": "Recommended Local Models", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Text queries are matched against stored image embeddings, so the model must place images and text in the same vector space; a chat or description model still returns vectors but retrieval quality silently degrades with no error."}, {"id": "genai_config_context_size", "label": "Provider Context Size Override", "file_type": "rationale", "source_file": "docs/docs/configuration/genai/config.md", "source_location": "llama.cpp / OpenAI-Compatible", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frigate derives the number of frames to send from the context size the provider reports; when a server misreports or does not expose it, provider_options.context_size pins the value so frames are not truncated and requests do not fail."}, {"id": "genai_config_thinking_modes", "label": "Instruct vs Thinking Model Modes", "file_type": "rationale", "source_file": "docs/docs/configuration/genai/config.md", "source_location": "Model Types: Instruct vs Thinking", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Description tasks are synthesis-only and benefit from concise output, so Frigate disables thinking for those calls when the model exposes a per-request toggle; chat leaves the toggle to the user."}, {"id": "genai_config_ollama", "label": "Ollama Provider", "file_type": "concept", "source_file": "docs/docs/configuration/genai/config.md", "source_location": "Ollama", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "genai_config_llamacpp", "label": "llama.cpp Provider", "file_type": "concept", "source_file": "docs/docs/configuration/genai/config.md", "source_location": "llama.cpp", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "genai_config_openai_compatible", "label": "OpenAI-Compatible Provider", "file_type": "concept", "source_file": "docs/docs/configuration/genai/config.md", "source_location": "OpenAI-Compatible", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "genai_config_gemini", "label": "Google Gemini Provider", "file_type": "concept", "source_file": "docs/docs/configuration/genai/config.md", "source_location": "Google Gemini", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "genai_config_azure_openai", "label": "Azure OpenAI Provider", "file_type": "concept", "source_file": "docs/docs/configuration/genai/config.md", "source_location": "Azure OpenAI", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "genai_config_debug_save_thumbnails", "label": "GenAI Request Debug Artifacts", "file_type": "concept", "source_file": "docs/docs/configuration/genai/config.md", "source_location": "FAQ: How do I debug GenAI issues?", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "debug_save_thumbnails writes the exact frames, prompt.txt and response.txt to /media/frigate/clips/genai-requests/ so poor results can be attributed to the image or the prompt before blaming the model."}, {"id": "genai_config_debug_faq", "label": "GenAI Debugging Workflow", "file_type": "concept", "source_file": "docs/docs/configuration/genai/config.md", "source_location": "FAQ", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provider configuration, object descriptions and review descriptions are enabled independently; a descriptions provider is only contacted on first use, so a working config can look broken until the feature itself is enabled."}], "edges": [{"source": "genai_config", "target": "genai_config_provider_roles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/config.md", "source_location": "Configuration", "weight": 1.0}, {"source": "genai_config_provider_roles", "target": "genai_config_embeddings_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/config.md", "source_location": "Recommended Local Models", "weight": 1.0}, {"source": "genai_config", "target": "genai_config_ollama", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/config.md", "source_location": "Ollama", "weight": 1.0}, {"source": "genai_config", "target": "genai_config_llamacpp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/config.md", "source_location": "llama.cpp", "weight": 1.0}, {"source": "genai_config", "target": "genai_config_openai_compatible", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/config.md", "source_location": "OpenAI-Compatible", "weight": 1.0}, {"source": "genai_con