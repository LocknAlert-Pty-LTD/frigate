{"nodes": [{"id": "frigate_timeline_timelineprocessor", "label": "TimelineProcessor", "file_type": "code", "source_file": "frigate/timeline.py", "source_location": "L18-229", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frigate_timeline_insert_or_save", "label": "TimelineProcessor.insert_or_save (pre-event cache)", "file_type": "code", "source_file": "frigate/timeline.py", "source_location": "L57-79", "rationale": "Timeline rows for an object with neither a clip nor a snapshot are buffered in pre_event_cache instead of inserted, because the parent Event row does not exist yet and the timeline would reference a missing event. Once the event is saved, the cached entries are flushed in order ahead of the current one.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frigate_timeline_handle_object_detection", "label": "TimelineProcessor.handle_object_detection", "file_type": "code", "source_file": "frigate/timeline.py", "source_location": "L81-192", "rationale": "Boxes and regions are converted to relative coordinates against the detect resolution before storage so timeline data stays valid if the detect resolution later changes. One update can emit several rows (entered_zone, stationary/active, attribute), and entered_zone is suppressed for stationary objects and for transitions out of all zones.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frigate_timeline_handle_api_entry", "label": "TimelineProcessor.handle_api_entry", "file_type": "code", "source_file": "frigate/timeline.py", "source_location": "L194-229", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "frigate_timeline_timelineprocessor", "target": "frigate_timeline_handle_object_detection", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/timeline.py", "source_location": "L51", "weight": 1.