{"nodes": [{"id": "shmcalculator_index_shmcalculator", "label": "ShmCalculator docs widget", "file_type": "code", "source_file": "docs/src/components/ShmCalculator/index.jsx", "source_location": "L5-201", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "shmcalculator_index_shm_sizing_formula", "label": "SHM sizing formula", "file_type": "concept", "source_file": "docs/src/components/ShmCalculator/index.jsx", "source_location": "L21-31", "rationale": "Shared memory per camera is (width * height * 1.5 * 20 + 270480) / 1048576 MB: 1.5 bytes/pixel for yuv420p, a 20 frame ring, plus fixed per-camera overhead, with a flat +40MB added once for logs. The inputs are the detect stream resolution rather than the record resolution because only detect frames are placed in shared memory; going above 720p is warned against since it costs SHM and CPU without improving detection accuracy.", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "shmcalculator_index_shmcalculator", "target": "shmcalculator_index_shm_sizing_formula", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/components/ShmCalculator/index.jsx", "source_location": "L21-31", "weight": 1.0}, {"source": "shmcalculator_index_shm_sizing_formula", "target": "frigate_app_start_detectors", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/components/ShmCalculator/index.jsx", "source_location": "L21-31", "weight": 1.0}], "hyperedges": []}