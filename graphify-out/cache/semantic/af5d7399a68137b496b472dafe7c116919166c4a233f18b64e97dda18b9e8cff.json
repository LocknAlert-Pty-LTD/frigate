{"nodes": [{"id": "advanced_system_logging", "label": "Frigate Logger Configuration", "file_type": "concept", "source_file": "docs/docs/configuration/advanced/system.md", "source_location": "Logging", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "advanced_system_environment_vars", "label": "environment_vars Substitution", "file_type": "rationale", "source_file": "docs/docs/configuration/advanced/system.md", "source_location": "environment_vars", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provided for Home Assistant OS users who cannot set container environment variables; values are stored in plain text in the config, so Docker env vars or secrets remain the recommended way to keep credentials out of the config. go2rtc is excluded because it is a separate process that only sees the container environment."}, {"id": "advanced_system_model_config", "label": "Custom Model Input Configuration", "file_type": "concept", "source_file": "docs/docs/configuration/advanced/system.md", "source_location": "model", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "advanced_system_labelmap", "label": "Labelmap Customization", "file_type": "rationale", "source_file": "docs/docs/configuration/advanced/system.md", "source_location": "labelmap", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Labels can be renamed but not added, because the mapping only relabels existing model classes. Renaming breaks alert labels, objects.track lists, and the special person/face and car/license_plate attribute associations, so those must be updated together."}, {"id": "advanced_system_networking_ports", "label": "Internal and External Listen Ports", "file_type": "rationale", "source_file": "docs/docs/configuration/advanced/system.md", "source_location": "Network Configuration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Internal (5000) and external (8971) ports must differ and Frigate refuses to start otherwise, because requests on the internal port are treated as authenticated admins; sharing a port would strip authentication from the external one. Nginx binds at startup so changes need a restart."}, {"id": "advanced_system_base_path", "label": "Custom Base Path", "file_type": "concept", "source_file": "docs/docs/configuration/advanced/system.md", "source_location": "Base path", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "advanced_system_config_validation", "label": "Config Validation Workflow", "file_type": "rationale", "source_file": "docs/docs/configuration/advanced/system.md", "source_location": "Validating your config.yml file updates", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frigate exits on an invalid config at startup, so validation is offered through the WebUI, the /api/config/save endpoint (returns 400 on invalid), and a --validate-config container run that returns 1/0 for CI use, to avoid a failed restart taking the NVR offline."}, {"id": "advanced_system_custom_ffmpeg", "label": "Custom ffmpeg and go2rtc Builds", "file_type": "concept", "source_file": "docs/docs/configuration/advanced/system.md", "source_location": "Custom Dependencies", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "data_object_detectors_models_model_type", "target": "advanced_system_model_config", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/docs/configuration/advanced/system.md", "source_location": "model", "weight": 1.0}, {"source": "configuration_config_env_substitution", "target": "advanced_system_environment_vars", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/docs/configuration/advanced/system.md