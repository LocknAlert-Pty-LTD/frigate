{"nodes": [{"id": "frigate_watchdog_frigatewatchdog", "label": "FrigateWatchdog", "file_type": "code", "source_file": "frigate/watchdog.py", "source_location": "L42-139", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frigate_watchdog_monitoredprocess", "label": "MonitoredProcess", "file_type": "code", "source_file": "frigate/watchdog.py", "source_location": "L20-39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frigate_watchdog_check_process", "label": "FrigateWatchdog._check_process", "file_type": "code", "source_file": "frigate/watchdog.py", "source_location": "L70-112", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frigate_watchdog_restart_backoff", "label": "Crash-loop restart backoff", "file_type": "rationale", "source_file": "frigate/watchdog.py", "source_location": "L16-39", "rationale": "Restart timestamps are kept in a bounded deque and pruned against a sliding 60 second window; after 5 restarts inside that window the watchdog stops respawning and only logs. This stops a process that fails immediately on start from being restarted forever and burying the real error in log noise. Exit code 0 is treated as an intentional exit and logged once, never restarted.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frigate_watchdog_stuck_detection", "label": "Stuck detection recovery", "file_type": "rationale", "source_file": "frigate/watchdog.py", "source_location": "L114-137", "rationale": "A detector whose detection_start timestamp is more than 10 seconds old is presumed wedged (usually a hung hardware accelerator) and is restarted in place. If the detect process is outright dead, the whole of Frigate is restarted instead, because detection is not optional and a partially working NVR silently missing objects is worse than a visible restart.", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "frigate_watchdog_frigatewatchdog", "target": "frigate_watchdog_check_process", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/watchdog.py", "source_location": "L137", "weight": 1.0}, {"source": "frigate_watchdog_check_process", "target": "frigate_watchdog_monitoredprocess", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/watchdog.py", "source_location": "L70-112", "weight": 1.0}, {"source": "frigate_watchdog_restart_backoff", "target": "frigate_watchdog_monitoredprocess", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/watchdog.py", "source_location": "L16-39", "weight": 1.0}, {"source": "frigate_watchdog_stuck_detection", "target": "frigate_watchdog_frigatewatchdog", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/watchdog.py", "source_location": "L114-137", "weight": 1.0}], "hyperedges": []}