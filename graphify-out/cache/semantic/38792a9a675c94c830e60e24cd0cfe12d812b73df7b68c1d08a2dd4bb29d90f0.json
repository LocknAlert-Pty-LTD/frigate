{"nodes": [{"id": "tensorrt_build_jetson_ffmpeg", "label": "build_jetson_ffmpeg.sh (patched ffmpeg for Jetson)", "file_type": "code", "source_file": "docker/tensorrt/build_jetson_ffmpeg.sh", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tensorrt_build_jetson_ffmpeg_nvmpi_rationale", "label": "Jetson nvmpi ffmpeg build rationale", "file_type": "rationale", "source_file": "docker/tensorrt/build_jetson_ffmpeg.sh", "source_location": "lines 3-5, 60-66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NVIDIA ships a Jetson ffmpeg deb with accelerated decoding only, so Frigate builds ffmpeg 6.0 from source with the jetson-ffmpeg nvmpi patch to get accelerated scaling and encoding. dGPU codecs (cuvid/nvenc/nvdec) are explicitly disabled while nvmpi and ffnvcodec are enabled, because the Jetson uses the tegra multimedia path rather than a discrete GPU. Stub libs are used at build time since the tegra multimedia libraries are not present in the build image."}], "edges": [{"source": "tensorrt_build_jetson_ffmpeg_nvmpi_rationale", "target": "tensorrt_build_jetson_ffmpeg", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docker/tensorrt/build_jetson_ffmpeg.sh", "source_location": "lines 3-5", "weight": 1.0}, {"source": "tensorrt_build_jetson_ffmpeg", "target": "rpi_install_deps", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docker/tensorrt/build_jetson_ffmpeg.sh", "source_location": null, "weight": 1.0}, {"source": "tensorrt_build_jetson_ffmpeg", "target": "util_config_resolve_ffmpeg_path", "relation": "shares_data_with", "confidence": "AMBIGUOUS", "confidence_score": 0.3, "source_file": "docker/tensorrt/build_jetson_ffmpeg.sh", "source_location": "line 8", "weight": 1.0}], "hyperedges": [{"id": "jetson_tensorrt_build_pipeline", "label": "Jetson/TensorRT arm64 i