{"nodes": [{"id": "api_chat_util_chunk_content", "label": "chunk_content", "file_type": "code", "source_file": "frigate/api/chat_util.py", "source_location": "L29-44", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_chat_util_format_events_with_local_time", "label": "format_events_with_local_time", "file_type": "code", "source_file": "frigate/api/chat_util.py", "source_location": "L47-69", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_chat_util_distance_to_score", "label": "distance_to_score", "file_type": "code", "source_file": "frigate/api/chat_util.py", "source_location": "L72-84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normalizes cosine distance with the ZScoreNormalization stats EmbeddingsContext already maintains so scores are comparable across deployments, then applies a bounded sigmoid. Uninitialized stats (stddev 0) return a neutral 0.5 so the raw-distance fallback ordering still dominates."}, {"id": "api_chat_util_fuse_scores", "label": "fuse_scores", "file_type": "code", "source_file": "frigate/api/chat_util.py", "source_location": "L87-103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visual weight 0.65 dominates description weight 0.35 because the feature's primary use case is finding the same specific object. A missing side is returned alone with no penalty rather than penalizing events lacking a description embedding."}, {"id": "api_chat_util_parse_iso_to_timestamp", "label": "parse_iso_to_timestamp", "file_type": "code", "source_file": "frigate/api/chat_util.py", "source_location": "L106-120", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_chat_util_hydrate_event", "label": "hydrate_event", "file_type": "code", "source_file": "frigate/api/chat_util.py", "source_location": "L123-136", "source_url": null, "captured_at": nul