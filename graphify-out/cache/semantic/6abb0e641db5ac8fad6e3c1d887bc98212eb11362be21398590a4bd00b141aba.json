{"nodes": [{"id": "configuration_authentication_native_auth", "label": "Frigate Native Authentication", "file_type": "document", "source_file": "docs/docs/configuration/authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "configuration_authentication_jwt_secret", "label": "JWT Token Secret Resolution", "file_type": "concept", "source_file": "docs/docs/configuration/authentication.md", "source_location": "JWT Token Secret", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "configuration_authentication_rate_limiting", "label": "Login Failure Rate Limiting", "file_type": "rationale", "source_file": "docs/docs/configuration/authentication.md", "source_location": "Login failure rate limiting", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "trusted_proxies must list upstream networks, otherwise the rate limit is keyed to the proxy IP and one brute force attempt locks out every other device behind the same proxy."}, {"id": "configuration_authentication_proxy_auth", "label": "Upstream Proxy Authentication", "file_type": "rationale", "source_file": "docs/docs/configuration/authentication.md", "source_location": "Proxy configuration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frigate deliberately does not implement OIDC, SAML or LDAP natively; as an NVR focused on recording and detection it delegates those protocols to battle-tested proxies and consumes the authenticated user and role through whitelisted headers."}, {"id": "configuration_authentication_role_mapping", "label": "Proxy Role Mapping", "file_type": "rationale", "source_file": "docs/docs/configuration/authentication.md", "source_location": "Role mapping", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "role_map translates upstream group claims into Frigate roles; admin takes precedence when several mappings match so a user belonging to both admin and viewer groups is not accidentally downgraded."}, {"id": "configuration_authentication_user_roles", "label": "User Roles and Camera Access", "file_type": "concept", "source_file": "docs/docs/configuration/authentication.md", "source_location": "User Roles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Roles are only enforced on the authenticated port 8971; port 5000 treats every request as anonymous with admin-level access by design, for unauthenticated internal use on a trusted network."}], "edges": [{"source": "configuration_authentication_native_auth", "target": "configuration_authentication_jwt_secret", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/authentication.md", "source_location": "JWT Token Secret", "weight": 1.0}, {"source": "configuration_authentication_native_auth", "target": "configuration_authentication_rate_limiting", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/authentication.md", "source_location": "Login failure rate limiting", "weight": 1.0}, {"source": "configuration_authentication_proxy_auth", "target": "configuration_authentication_role_mapping", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/authentication.md", "source_location": "Role mapping", "weight": 1.0}, {"source": "configuration_authentication_role_mapping", "target": "configuration_authentication_user_roles", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/authentication.md", "source_location": "Supported Roles", "weight": 1.0}, {"source": "configuration_authentication_proxy_auth", "target": "configuration_authentication_native_auth", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/authentication.md", "source_location": "Proxy configuration", "weight": 1.0}, {"source": "advanced_system_logging", "target": "configuration_authentication_role_mapping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/authentication.md", "source_location": "frigate.api.auth debug note", "weight": 1.0}], "hyperedges": []}