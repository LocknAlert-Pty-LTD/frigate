{"nodes": [{"id": "helpers_api_mocker_apimocker", "label": "ApiMocker", "file_type": "code", "source_file": "web/e2e/helpers/api-mocker.ts", "source_location": "L46-226", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The generic **/api/** handler must use route.fallback() for GET so that Playwright's LIFO route matching still lets the specific routes registered earlier win; only mutating methods are short-circuited to {success:true}. The review routes are regex-scoped to /api/review (singular) because an earlier plural **/api/reviews** glob never matched the real endpoint and review-dependent tests silently ran with no data."}, {"id": "helpers_api_mocker_mediamocker", "label": "MediaMocker", "file_type": "code", "source_file": "web/e2e/helpers/api-mocker.ts", "source_location": "L228-284", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "helpers_api_mocker_loadmockjson", "label": "loadMockJson", "file_type": "code", "source_file": "web/e2e/helpers/api-mocker.ts", "source_location": "L23-25", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "helpers_api_mocker_apimockoverrides", "label": "ApiMockOverrides contract", "file_type": "concept", "source_file": "web/e2e/helpers/api-mocker.ts", "source_location": "L33-44", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "helpers_api_mocker_apimocker", "target": "helpers_api_mocker_loadmockjson", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "web/e2e/helpers/api-mocker.ts", "source_location": "L57-64", "weight": 1.0}, {"source": "helpers_api_mocker_apimocker", "target": "mock_data_profile_adminprofile", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "web/e2e/helpers/api-mocker.ts", "source_location": "L55", "weight": 1.0}, {"source": "helpers_api_mocker_apimocker", "target"