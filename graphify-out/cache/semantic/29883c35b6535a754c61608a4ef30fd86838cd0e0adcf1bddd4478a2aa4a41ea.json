{"nodes": [{"id": "test_test_ptz_onvif_testonvifinitrequests", "label": "TestOnvifInitRequests", "file_type": "code", "source_file": "frigate/test/test_ptz_onvif.py", "source_location": "135", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "test_test_ptz_onvif_testmanualrelativemovemetrics", "label": "TestManualRelativeMoveMetrics", "file_type": "code", "source_file": "frigate/test/test_ptz_onvif.py", "source_location": "181", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "test_test_ptz_onvif_init_implies_requests_exist", "label": "init=True implies request objects exist", "file_type": "rationale", "source_file": "frigate/test/test_ptz_onvif.py", "source_location": "1-16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In the normal wizard flow ONVIF is set up before autotracking is enabled. Autotracking-only request objects used to be created only when autotracking was on at init time, leaving init=True with no status_request; get_camera_status skips its re-init branch when init is True and then raised KeyError on the tracking thread. The requests come from the locally parsed WSDL and cost no network, so they are always built. Inversely, manual relative moves must not write ptz movement timestamps for a non-autotracking camera, because only camera_maintenance polls get_camera_status to clear them, and a stuck clock suppresses promotion of motion boxes to detection regions, stopping object detection entirely."}], "edges": [{"source": "test_test_ptz_onvif_testonvifinitrequests", "target": "ptz_onvif_onvifcontroller", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/test/test_ptz_onvif.py", "source_location": "140", "weight": 1.0}, {"source": "test_test_ptz_onvif_testmanualrelativemovemetrics", "target": "ptz_onvif_onvifcontroller", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/test/test_ptz_onvif.py", "source_location": "192", "weight": 1.0}, {"source": "test_test_ptz_onvif_testmanualrelativemovemetrics", "target": "ptz_autotrack_ptz_moving_at_frame_time", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/test/test_ptz_onvif.py", "source_location": "211", "weight": 1.0}, {"source": "ptz_onvif_onvifcontroller", "target": "camera_ptzmetrics", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/test/test_ptz_onvif.py", "source_location": "129", "weight": 1.0}, {"source": "ptz_autotrack_ptz_moving_at_frame_time", "target": "camera_ptzmetrics", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/test/test_ptz_onvif.py", "source_location": "211-216", "weight": 1.0}, {"source": "test_test_ptz_onvif_init_implies_requests_exist", "target": "ptz_onvif_onvifcontroller", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/test/test_ptz_onvif.py", "source_location": "1", "weight": 1.0}], "hyperedges": []}