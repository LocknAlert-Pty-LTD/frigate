_file": "docs/docs/configuration/cameras.md", "source_location": "Setting up camera PTZ controls", "weight": 1.0}, {"source": "configuration_cameras_ptz_recommendations", "target": "configuration_cameras_onvif_ptz", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/cameras.md", "source_location": "ONVIF PTZ camera recommendations", "weight": 1.0}], "hyperedges": []}