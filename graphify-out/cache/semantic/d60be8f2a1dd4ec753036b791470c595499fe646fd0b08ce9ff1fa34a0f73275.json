{"nodes": [{"id": "configuration_cameras_camera_configuration", "label": "Camera Configuration", "file_type": "document", "source_file": "docs/docs/configuration/cameras.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "configuration_cameras_add_camera_wizard", "label": "Add Camera Wizard", "file_type": "rationale", "source_file": "docs/docs/configuration/cameras.md", "source_location": "Adding a camera with the Add Camera Wizard", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The wizard probes over ONVIF or templates a brand URL, tests each stream, and writes the go2rtc restream plus live stream mapping so a standard setup needs no hand written YAML; validation catches the common misconfigurations (detect resolution too high or low, non-AAC audio on a record stream, a restreamed input used for record, brand specific stream type mistakes)."}, {"id": "configuration_cameras_input_roles", "label": "Camera Input Roles", "file_type": "rationale", "source_file": "docs/docs/configuration/cameras.md", "source_location": "Setting Up Camera Inputs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each of detect, record and audio may be assigned to only one input per camera, allowing a low resolution stream for detection and a high resolution one for recording. A detect stream is always decoded (for motion, Birdseye and image endpoints) even with object detection disabled, so a low resolution detect role is recommended even for record-only setups."}, {"id": "configuration_cameras_camera_deletion", "label": "Camera Deletion Cleanup", "file_type": "rationale", "source_file": "docs/docs/configuration/cameras.md", "source_location": "Deleting a camera", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deletion removes config, database records and media but deliberately keeps exports so saved footage survives; go2rtc stream entries and camera group references are left behind because they are harmless and outside the camera's own config section. A failed parse restores the previous config rather than leaving Frigate broken."}, {"id": "configuration_cameras_onvif_ptz", "label": "ONVIF PTZ Controls", "file_type": "concept", "source_file": "docs/docs/configuration/cameras.md", "source_location": "Setting up camera PTZ controls", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tls_insecure falls back to plaintext PasswordText for cameras that reject digest tokens, and ignore_time_mismatch compensates for clock skew in ONVIF tokens; both weaken security so NTP on both ends is the preferred fix."}, {"id": "configuration_cameras_ptz_recommendations", "label": "ONVIF PTZ Camera Recommendations", "file_type": "document", "source_file": "docs/docs/configuration/cameras.md", "source_location": "ONVIF PTZ camera recommendations", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "configuration_cameras_camera_groups", "label": "Camera Groups", "file_type": "concept", "source_file": "docs/docs/configuration/cameras.md", "source_location": "Setting up camera groups", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "configuration_authentication_user_roles", "target": "configuration_cameras_camera_deletion", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/docs/configuration/cameras.md", "source_location": "Deleting a camera removes role camera lists", "weight": 1.0}, {"source": "configuration_cameras_camera_configuration", "target": "configuration_cameras_add_camera_wizard", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/cameras.md", "source_location": "Adding a camera with the Add Camera Wizard