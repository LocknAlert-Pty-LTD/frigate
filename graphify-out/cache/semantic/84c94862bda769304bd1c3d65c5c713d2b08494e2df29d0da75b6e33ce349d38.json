{"nodes": [{"id": "frigate_installation", "label": "Installation", "file_type": "document", "source_file": "docs/docs/frigate/installation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "frigate_installation_storage_paths", "label": "Container Storage Paths", "file_type": "concept", "source_file": "docs/docs/frigate/installation.md", "source_location": "Storage", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/config holds config and the SQLite DB, /media/frigate holds clips, recordings and exports, and /tmp/cache should be tmpfs because segments are written there before conversion to mp4."}, {"id": "frigate_installation_shm_size", "label": "shm-size Calculation", "file_type": "rationale", "source_file": "docs/docs/frigate/installation.md", "source_location": "Calculating required shm-size", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decoded frames live in shared memory, so undersized /dev/shm produces 'Bus error' exits; logs also consume up to 40MB of shm and must be included in the math."}, {"id": "frigate_installation_process_limits", "label": "Process and File Descriptor Limits", "file_type": "rationale", "source_file": "docs/docs/frigate/installation.md", "source_location": "Process and file limits", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hitting the PID limit logs 'can't start new thread' followed by a Bus error that mimics an shm sizing problem, so pids-limit and nofile ulimits must be checked before enlarging shm further."}, {"id": "frigate_installation_ports", "label": "Frigate Network Ports", "file_type": "concept", "source_file": "docs/docs/frigate/installation.md", "source_location": "Ports", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "8971 is the authenticated UI/API entry point for reverse proxies while 5000 is unauthenticated and should be restricted to the docker network; 8554 restreams RTSP and 8555 carries WebRTC."}, {"id": "frigate_installation_home_assistant_app", "label": "Home Assistant App Installation", "file_type": "concept", "source_file": "docs/docs/frigate/installation.md", "source_location": "Home Assistant App", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The App is not the Home Assistant integration; HA OS lacks the mesa driver, NPU firmware and Nvidia runtime, so those accelerators are unavailable and hardware acceleration may require the Full Access variant."}, {"id": "frigate_installation_virtualization", "label": "Virtualization Guidance (Proxmox / ESXi)", "file_type": "rationale", "source_file": "docs/docs/frigate/installation.md", "source_location": "Proxmox", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frigate wants low overhead access to Coral and GPU devices, so bare metal Debian is preferred; if virtualized, a QEMU VM with ballooning disabled is recommended over LXC because passing devices through two container layers is difficult and unsupported."}], "edges": [{"source": "frigate_installation", "target": "frigate_installation_storage_paths", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/frigate/installation.md", "source_location": "Storage", "weight": 1.0}, {"source": "frigate_installation", "target": "frigate_installation_shm_size", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/frigate/installation.md", "source_location": "Calculating required shm-size", "weight": 1.0}, {"source": "frigate_installation_shm_size", "target": "frigate_installation_process_limits", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/frigate/installation.md", "source_location": "links to 