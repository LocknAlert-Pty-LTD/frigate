, "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/custom_classification/object_classification.md", "source_location": "Debugging Classification Models", "weight": 1.0}, {"source": "custom_classification_object_classification", "target": "frigate_network_requirements_model_cache", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/custom_classification/object_classification.md", "source_location": "info callout linking /frigate/network_requirements#one-time-model-downloads", "weight": 1.0}, {"source": "custom_classification_object_classification", "target": "custom_classification_state_classification", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/docs/configuration/custom_classification/object_classification.md", "source_location": "classification.custom config block shared by both model types", "weight": 1.0}, {"source": "custom_classification_object_classification", "target": "frigate_planning_setup_avx_requirement", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/docs/configuration/custom_classification/object_classification.md", "source_location": "A CPU with AVX + AVX2 instructions is required for training and inference", "weight": 1.0}], "hyperedges": []}