{"nodes": [{"id": "custom_classification_object_classification", "label": "Object Classification", "file_type": "document", "source_file": "docs/docs/configuration/custom_classification/object_classification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "custom_classification_object_classification_sub_label_type", "label": "Sub Label Classification Type", "file_type": "concept", "source_file": "docs/docs/configuration/custom_classification/object_classification.md", "source_location": "Classification Type", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A tracked object can hold only one sub label, so face recognition, LPR, triggers and a sub_label classification model race each other; the attribute type is recommended when collisions are possible."}, {"id": "custom_classification_object_classification_attribute_type", "label": "Attribute Classification Type", "file_type": "concept", "source_file": "docs/docs/configuration/custom_classification/object_classification.md", "source_location": "Classification Type", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attributes are metadata that can coexist independently on one object, so multiple simultaneous properties (helmet, vest, backpack) can be represented without contention."}, {"id": "custom_classification_object_classification_class_consensus", "label": "Threshold and Class Consensus Assignment", "file_type": "rationale", "source_file": "docs/docs/configuration/custom_classification/object_classification.md", "source_location": "Assignment Requirements", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requiring both a per-attempt threshold (default 0.8) and 60% agreement across at least 3 attempts prevents false positives from a single lucky frame before a sub label or attribute is committed."}, {"id": "custom_classification_object_classification_none_class", "label": "The none Class", "file_type": "rationale", "source_file": "docs/docs/configuration/custom_classification/object_classification.md", "source_location": "none works differently from named classes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named classes want visually uniform examples, but none must absorb everything unknown at inference, so it needs deliberate visual diversity (small crops, partial views, false positives) or the model forces ambiguous crops into a named class."}, {"id": "custom_classification_object_classification_diversity_over_volume", "label": "Diversity Over Volume Training Principle", "file_type": "rationale", "source_file": "docs/docs/configuration/custom_classification/object_classification.md", "source_location": "Improving the Model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MobileNetV2 overfits quickly on homogeneous data and learns a single moment rather than the class, which is the stated reason Frigate deliberately does not implement bulk training in the UI."}, {"id": "custom_classification_object_classification_crop_size", "label": "Minimum Crop Size Guidance", "file_type": "rationale", "source_file": "docs/docs/configuration/custom_classification/object_classification.md", "source_location": "Improving the Model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Crops under ~80x80 are stretched 3-7x by the 224x224 model input resize and collapse into a generic blob region of feature space, so aim for at least 100x100 or reposition the camera."}, {"id": "custom_classification_object_classification_class_balance", "label": "Class Balance Rule", "file_type": "rationale", "source_file": "docs/docs/configuration/custom_classification/object_classification.md", "source_location": "Improving the Model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeping the largest class within ~3x the smallest avoids bias where borderline predictions default to the dominant class (the 'everything looks like Buddy' failure mode)."}, {"id": "custom_classification_object_classification_debug_logging", "label": "Custom Classification Debug Logging", "file_type": "concept", "source_file": "docs/docs/configuration/custom_classification/object_classification.md", "source_location": "Debugging Classification Models", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "custom_classification_object_classification", "target": "custom_classification_object_classification_sub_label_type", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/custom_classification/object_classification.md", "source_location": "Classification Type", "weight": 1.0}, {"source": "custom_classification_object_classification", "target": "custom_classification_object_classification_attribute_type", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/custom_classification/object_classification.md", "source_location": "Classification Type", "weight": 1.0}, {"source": "custom_classification_object_classification", "target": "custom_classification_object_classification_class_consensus", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/custom_classification/object_classification.md", "source_location": "Assignment Requirements", "weight": 1.0}, {"source": "custom_classification_object_classification_class_consensus", "target": "custom_classification_object_classification_sub_label_type", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/custom_classification/object_classification.md", "source_