{"nodes": [{"id": "ptz_autotrack_ptzautotrackerthread", "label": "PtzAutoTrackerThread", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": "L183-L221", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ptz_autotrack_ptzautotracker", "label": "PtzAutoTracker", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": "L224-L1580", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ptz_autotrack_ptzmotionestimator", "label": "PtzMotionEstimator", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": "L71-L180", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ptz_autotrack_ptz_moving_at_frame_time", "label": "ptz_moving_at_frame_time", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": "L45-L52", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ptz_autotrack_transform_is_finite", "label": "transform_is_finite", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": "L55-L68", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A near-singular homography (common when the motion estimator lacks stable features while zooming a low-texture scene) yields inf/nan matrix entries; norfair accumulates the homography across frames, so one bad transform poisons every later one and propagates nan into the tracker distance function, crashing the camera process. Bad transforms are dropped and the estimator is reset instead."}, {"id": "ptz_autotrack__autotracker_setup", "label": "PtzAutoTracker._autotracker_setup", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": "L303-L413", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ptz_autotrack__calibrate_camera", "label": "PtzAutoTracker._calibrate_camera", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": "L431-L606", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The camera is stepped from a preset in measured increments so a simple linear regression can predict movement times; predicted times let the tracker aim at where the object will be rather than where it was."}, {"id": "ptz_autotrack__process_move_queue", "label": "PtzAutoTracker._process_move_queue", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": "L792-L877", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ptz_autotrack__enqueue_move", "label": "PtzAutoTracker._enqueue_move", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": "L879-L914", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ptz_autotrack__should_zoom_in", "label": "PtzAutoTracker._should_zoom_in", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": "L1048-L1179", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zoom decisions use hysteresis thresholds (AUTOTRACKING_ZOOM_IN/OUT_HYSTERESIS) to prevent a yo-yo zooming effect, and refuse to zoom in while the box touches frame edges or the object moves quickly."}, {"id": "ptz_autotrack__get_zoom_amount", "label": "PtzAutoTracker._get_zoom_amount", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": "L1294-L1394", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ptz_autotrack_autotrack_object", "label": "PtzAutoTracker.autotrack_object", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": "L1402-L1508", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ptz_autotrack__autotrack_move_ptz", "label": "PtzAutoTracker._autotrack_move_ptz", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": "L1181-L1283", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ptz_autotrack_camera_maintenance", "label": "PtzAutoTracker.camera_maintenance", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": "L1525-L1580", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ptz_autotrack_check_for_updates", "label": "PtzAutoTracker.check_for_updates", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": "L280-L301", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Camera processes read ptz_metrics.autotracker_enabled instead of the config object, so every config path that can toggle autotracking must mirror its value into the metrics, not just the mqtt toggle that writes it directly."}, {"id": "ptz_autotrack_transform_is_finite", "label": "transform_is_finite", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": "55", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ptz_autotrack_ptzautotracker", "label": "PtzAutoTracker", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ptz_autotrack_ptz_moving_at_frame_time", "label": "ptz_moving_at_frame_time", "file_type": "code", "source_file": "frigate/ptz/autotrack.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "ptz_autotrack_ptzautotrackerthread", "target": "ptz_autotrack_ptzautotracker", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/ptz/autotrack.py", "source_location": "L193-L218", "weight": 1.0}, {"source": "ptz_autotrack_ptz