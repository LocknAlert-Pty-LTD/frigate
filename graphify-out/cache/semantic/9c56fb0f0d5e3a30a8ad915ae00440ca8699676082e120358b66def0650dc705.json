{"nodes": [{"id": "configuration_config_overrides_inheritance", "label": "Global and Camera-Level Config Inheritance", "file_type": "rationale", "source_file": "docs/docs/configuration/config_overrides.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A camera value counts as an override because it is written in the config, not because it differs from the global value, so repeating the global value still detaches the camera; the key must be deleted to inherit again. Overrides apply per value, not per section."}, {"id": "configuration_config_overrides_lists_maps", "label": "Lists Replace, Maps Merge", "file_type": "rationale", "source_file": "docs/docs/configuration/config_overrides.md", "source_location": "Lists replace, maps merge", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A camera list takes the place of the global list rather than adding to it, which makes an empty list the normal way to opt a camera out; maps merge key by key so a camera can add one filter without redeclaring the inherited ones."}, {"id": "configuration_config_overrides_global_enrichment_gate", "label": "Globally Gated Enrichments", "file_type": "rationale", "source_file": "docs/docs/configuration/config_overrides.md", "source_location": "Enrichments that must be enabled globally first", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lpr and face_recognition must be enabled globally before any camera can use them because the global setting controls whether the supporting background process starts at all; enabling one only on a camera is a startup error. Audio transcription does not work this way."}], "edges": [{"source": "configuration_config_overrides_inheritance", "target": "advanced_reference_full_config", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/confi