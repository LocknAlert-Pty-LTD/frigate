{"nodes": [{"id": "views_settings", "label": "Settings View Strings (EN)", "file_type": "document", "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_frigate_plus", "label": "Frigate+", "file_type": "concept", "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_go2rtc", "label": "go2rtc restreaming", "file_type": "concept", "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_onvif", "label": "ONVIF camera protocol", "file_type": "concept", "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_mqtt", "label": "MQTT", "file_type": "concept", "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_semantic_search", "label": "Semantic Search", "file_type": "concept", "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small model size uses a quantized version that uses less RAM and runs faster on CPU with negligible quality difference; large model size uses the full Jina model and automatically runs on GPU if applicable. Jina V2 small model on CPU has high RAM/inference cost, so large model with a discrete GPU is recommended."}, {"id": "concept_face_recognition", "label": "Face Recognition", "file_type": "concept", "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small model uses a FaceNet embedding model that runs efficiently on most CPUs; large model uses an ArcFace embedding model and automatically runs on GPU if applicable, since the large model requires a GPU/NPU for reasonable performance."}, {"id": "concept_license_plate_recognition", "label": "License Plate Recognition (LPR)", "file_type": "concept", "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large model is optimized for multi-line license plates; small model provides better performance and should be used unless the region uses multi-line plate formats."}, {"id": "concept_generative_ai", "label": "Generative AI (GenAI)", "file_type": "concept", "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_ffmpeg", "label": "FFmpeg", "file_type": "concept", "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_motion_detection_tuner", "label": "Motion Detection Tuner", "file_type": "concept", "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Motion masks should be used very sparingly; over-masking makes it more difficult for objects to be tracked, and a required zone should be used instead of a large motion mask."}, {"id": "concept_birdseye", "label": "Birdseye", "file_type": "concept", "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_region_grid", "label": "Region Grid", "file_type": "concept", "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The region grid is an optimization that learns where objects of different sizes typically appear in each camera's field of view, so Frigate can efficiently size detection regions; it is built automatically over time from tracked object data and should rarely be cleared manually."}, {"id": "concept_media_sync", "label": "Media Sync", "file_type": "concept", "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_triggers", "label": "Triggers (Semantic Search-based)", "file_type": "concept", "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_camera_wizard", "label": "Add Camera Wizard", "file_type": "concept", "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "views_settings", "target": "concept_frigate_plus", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "weight": 1.0}, {"source": "views_settings", "target": "concept_go2rtc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "weight": 1.0}, {"source": "views_settings", "target": "concept_onvif", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "web/public/locales/en/views/settings.json", "source_location": null, "weight": 1.0}, {"source": "views_settings", "target": "concept_