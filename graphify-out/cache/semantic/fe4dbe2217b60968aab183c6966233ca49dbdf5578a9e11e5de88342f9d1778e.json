{"nodes": [{"id": "record_export_recordingexporter", "label": "RecordingExporter", "file_type": "code", "source_file": "frigate/record/export.py", "source_location": "L204-L993", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "record_export_validate_ffmpeg_args", "label": "validate_ffmpeg_args", "file_type": "code", "source_file": "frigate/record/export.py", "source_location": "L151-L196", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every token must be an allowlisted flag or its value, and no token may become a bare input/output URL, which structurally prevents arbitrary file read/write, network exfiltration/SSRF, and resource exhaustion through the export endpoint. Admin users are trusted and skip validation."}, {"id": "record_export__validate_filtergraph", "label": "_validate_filtergraph", "file_type": "code", "source_file": "frigate/record/export.py", "source_location": "L126-L148", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "record_export_get_record_export_command", "label": "RecordingExporter.get_record_export_command", "file_type": "code", "source_file": "frigate/record/export.py", "source_location": "L686-L785", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "record_export_get_preview_export_command", "label": "RecordingExporter.get_preview_export_command", "file_type": "code", "source_file": "frigate/record/export.py", "source_location": "L787-L894", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "record_export_save_thumbnail", "label": "RecordingExporter.save_thumbnail", "file_type": "code", "source_file": "frigate/record/export.py", "source_location": "L583-L684", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "record_export__build_chapter_metadata_file", "label": "RecordingExporter._build_chapter_metadata_file", "file_type": "code", "source_file": "frigate/record/export.py", "source_location": "L386-L513", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The VOD endpoint concatenates recording clips back to back, so wall-clock gaps collapse in the produced video; chapter offsets must therefore be computed in output time by walking the same recording rows that build the playlist."}, {"id": "record_export__build_recording_segment_chapter_metadata_file", "label": "RecordingExporter._build_recording_segment_chapter_metadata_file", "file_type": "code", "source_file": "frigate/record/export.py", "source_location": "L515-L581", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One ISO 8601 chapter per recording segment lets a viewer map any playback position back to real-world time without OCR-ing a burnt-in timestamp."}, {"id": "record_export__expected_output_duration_seconds", "label": "RecordingExporter._expected_output_duration_seconds", "file_type": "code", "source_file": "frigate/record/export.py", "source_location": "L252-L342", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Users often request a wide time range when only a few minutes of recordings exist on disk, so progress based on the requested range plateaus early; actual saved seconds are summed from Recordings/Previews and scaled by the timelapse setpts factor."}, {"id": "record_export_migrate_exports", "label": "migrate_exports", "file_type": "code", "source_file": "frigate/record/export.py", "source_location": "L996-L1051", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "record_export_validate_ffmpeg_args", "label": "validate_ffmpeg_args", "file_type": "code", "source_file": "frigate/record/export.py", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "record_export_recordingexporter", "la