{"nodes": [{"id": "genai_objects", "label": "Object Descriptions", "file_type": "document", "source_file": "docs/docs/configuration/genai/objects.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "genai_objects_intent_prompting", "label": "Intent-Focused Prompting", "file_type": "rationale", "source_file": "docs/docs/configuration/genai/objects.md", "source_location": "Usage and Best Practices", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default prompts ask for intent rather than appearance because descriptions say what is happening while intent gives context, letting loitering or after-hours approach trigger attention sooner than a neutral appearance caption."}, {"id": "genai_objects_custom_prompts", "label": "Layered Custom Prompts", "file_type": "concept", "source_file": "docs/docs/configuration/genai/objects.md", "source_location": "Custom Prompts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prompts resolve global then camera then per-object-label, with only {label}, {sub_label} and {camera} substituted, so a per-label prompt can be tuned without losing the global default."}, {"id": "genai_objects_use_snapshot", "label": "Snapshot vs Thumbnail Source", "file_type": "rationale", "source_file": "docs/docs/configuration/genai/objects.md", "source_location": "Object Descriptions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "use_snapshot trades multi-frame movement and direction cues for a single higher quality image, which is useful when regenerating a description but limits the model's ability to judge motion."}, {"id": "genai_objects_send_triggers", "label": "Description Send Triggers", "file_type": "concept", "source_file": "docs/docs/configuration/genai/objects.md", "source_location": "Object Descriptions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requests fire at the end of the tracked object lifecycle by default, or earlier after a number of significantly changed frames for more real-time notifications."}], "edges": [{"source": "genai_objects", "target": "genai_config_debug_faq", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/objects.md", "source_location": "Troubleshooting links genai_config#how-do-i-debug-genai-issues", "weight": 1.0}, {"source": "genai_objects", "target": "genai_objects_intent_prompting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/objects.md", "source_location": "Usage and Best Practices", "weight": 1.0}, {"source": "genai_objects", "target": "genai_objects_custom_prompts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/objects.md", "source_location": "Custom Prompts", "weight": 1.0}, {"source": "genai_objects", "target": "genai_objects_use_snapshot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/objects.md", "source_location": "Object Descriptions", "weight": 1.0}, {"source": "genai_objects", "target": "genai_objects_send_triggers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/objects.md", "source_location": "Object Descriptions", "weight": 1.0}, {"source": "genai_objects", "target": "frigate_glossary_tracked_object", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/docs/configuration/genai/objects.md", "source_location": "descriptions generated for tracked objects", "weight": 1.0}, {"source": "genai_objects", "target": "genai_config_provider_roles", "relation": "references", "confidence": "EXTRA