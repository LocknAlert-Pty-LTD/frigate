{"nodes": [{"id": "genai_review_summaries", "label": "Review Summaries", "file_type": "document", "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "genai_review_summaries_structured_response", "label": "Structured Review Summary Schema", "file_type": "concept", "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": "Review Summary Usage and Best Practices", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The JSON schema (title, scene, shortSummary, confidence, other_concerns, potential_threat_level) lets notifications show a short form while the UI keeps the full narrative; smaller models often fail to follow it, producing parse errors."}, {"id": "genai_review_summaries_activity_context_prompt", "label": "Activity Context Prompt", "file_type": "rationale", "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": "Defining Typical Activity", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normal activity differs per installation and per camera, so the prompt is overridable globally and per camera, but must not be overly specific because it sways the model's threat level scoring."}, {"id": "genai_review_summaries_threat_level", "label": "Potential Threat Level Scale", "file_type": "concept", "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": "Default Activity Context Prompt", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Levels 0/1/2 are evaluated in order (verified person, then time and action checks, then escalation on weapons or forced entry) so that an unidentified person in private areas at night is always flagged for human review."}, {"id": "genai_review_summaries_image_source", "label": "Review Image Source Selection", "file_type": "rationale", "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": "Image Source", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preview frames use fewer tokens per image while recordings give 480p detail for plates and text; recordings cost more tokens so fewer frames fit, and the system falls back to previews when recordings are unavailable."}, {"id": "genai_review_summaries_frame_budget", "label": "Dynamic Frame Count Budgeting", "file_type": "rationale", "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": "Image Source", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frame counts are computed from context window size, camera aspect ratio and image source to fill ~98% of the context while capping at 20 frames to keep inference times reasonable."}, {"id": "genai_review_summaries_reports", "label": "Review Reports", "file_type": "concept", "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": "Review Reports", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aggregates suspicious review items across cameras over a time window into one report, requestable via the summarize API or the frigate.review_summarize Home Assistant service for vacation or daily digests."}], "edges": [{"source": "genai_review_summaries", "target": "genai_config_debug_faq", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": "Troubleshooting links genai_config#how-do-i-debug-genai-issues", "weight": 1.0}, {"source": "genai_review_summaries", "target": "genai_review_summaries_structured_response", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": "Review Summary Usage and Best Practices", "weight": 1.0}, {"source": "genai_review_summaries", "target": "genai_review_summaries_activity_context_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": "Defining Typical Activity", "weight": 1.0}, {"source": "genai_review_summaries_activity_context_prompt", "target": "genai_review_summaries_threat_level", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": "Default Activity Context Prompt", "weight": 1.0}, {"source": "genai_review_summaries_threat_level", "target": "genai_review_summaries_structured_response", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": "potential_threat_level field", "weight": 1.0}, {"source": "genai_review_summaries", "target": "genai_review_summaries_image_source", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": "Image Source", "weight": 1.0}, {"source": "genai_review_summaries_image_source", "target": "genai_review_summaries_frame_budget", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": "Image Source", "weight": 1.0}, {"source": "genai_review_summaries_frame_budget", "target": "genai_config_context_size", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": "frame count derived from provider context window", "weight": 1.0}, {"source": "genai_review_summaries", "target": "genai_review_summaries_reports", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": "Review Reports", "weight": 1.0}, {"source": "genai_review_summaries", "target": "frigate_glossary_review_item", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": "summaries generated per review item", "weight": 1.0}, {"source": "genai_review_summaries_activity_context_prompt", "target": "genai_objects_custom_prompts", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/docs/configuration/genai/review_summaries.md", "source_location": "both are global/camera-overridable prompt customization points", "weight": 1.0}], "hyperedges": [{"id": "genai_context_window_budget_flow", "label": "Context Window Drives GenAI Frame Budget", "nodes": ["genai_config_context_size", "genai_review_summaries_frame_budget", "genai_review_summaries_image_source", "genai_config_debug_faq"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/docs/configuration/genai/review_summaries.md"}]}