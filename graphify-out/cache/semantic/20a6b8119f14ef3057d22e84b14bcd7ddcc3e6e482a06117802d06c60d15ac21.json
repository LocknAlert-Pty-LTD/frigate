{"nodes": [{"id": "db_sqlitevecq_sqlitevecqueuedatabase", "label": "SqliteVecQueueDatabase", "file_type": "code", "source_file": "frigate/db/sqlitevecq.py", "source_location": "13-105", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extends peewee's SqliteQueueDatabase so every new connection loads the sqlite-vec extension and registers a timeout-bounded REGEXP function, keeping vector search and regex filters available to all queries."}, {"id": "db_sqlitevecq_connect", "label": "SqliteVecQueueDatabase._connect", "file_type": "code", "source_file": "frigate/db/sqlitevecq.py", "source_location": "22-30", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "db_sqlitevecq_load_vec_extension", "label": "SqliteVecQueueDatabase._load_vec_extension", "file_type": "code", "source_file": "frigate/db/sqlitevecq.py", "source_location": "32-41", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "db_sqlitevecq_register_regexp", "label": "SqliteVecQueueDatabase._register_regexp", "file_type": "code", "source_file": "frigate/db/sqlitevecq.py", "source_location": "43-54", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REGEXP is bounded by a 1 second timeout and swallows regex errors so a malicious or pathological user pattern cannot hang the shared database queue thread."}, {"id": "db_sqlitevecq_delete_embeddings", "label": "SqliteVecQueueDatabase._delete_embeddings", "file_type": "code", "source_file": "frigate/db/sqlitevecq.py", "source_location": "56-76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Embeddings outlive the events they belong to when semantic search is disabled, so deletes are attempted regardless of current config, guarded by a sqlite_master existence check because the vec0 tables only exist once semantic search has run."}, {"id": "db_sqlitevecq_create_embeddi