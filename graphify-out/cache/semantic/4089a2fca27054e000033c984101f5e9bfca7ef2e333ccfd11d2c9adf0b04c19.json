{"nodes": [{"id": "detectors_detection_runners_basemodelrunner", "label": "BaseModelRunner", "file_type": "code", "source_file": "frigate/detectors/detection_runners.py", "source_location": "92-112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One runner interface (get_input_names/get_input_width/run) lets detectors and embedding models share hardware backends without knowing which runtime was selected."}, {"id": "detectors_detection_runners_get_optimized_runner", "label": "get_optimized_runner", "file_type": "code", "source_file": "frigate/detectors/detection_runners.py", "source_location": "579-636", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend selection ladder: RKNN auto-conversion first, then OpenVINO only when ORT falls back to CPUExecutionProvider (there is no way to prioritize OpenVINO over CUDA/ROCm images), then CUDA graphs for supported models, and MIGraphX is dropped for models it cannot compile."}, {"id": "detectors_detection_runners_onnxmodelrunner", "label": "ONNXModelRunner", "file_type": "code", "source_file": "frigate/detectors/detection_runners.py", "source_location": "115-184", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds an optional inference lock because JinaV2 shares one runner between text and vision embeddings called from different threads."}, {"id": "detectors_detection_runners_cudagraphrunner", "label": "CudaGraphRunner", "file_type": "code", "source_file": "frigate/detectors/detection_runners.py", "source_location": "187-260", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Captures a CUDA graph on first run via IOBinding then replays it with update_inplace; CUDA graphs limit supported operations so CLIP, PaddleOCR, YOLO-NAS and D-FINE are excluded."}, {"id": "detectors_detection_runners_openvinomodelrunner", "label": "OpenVINOModelRunner", "file_type": "code", "source_file": "frigate/detectors/detection_runners.py", "source_location": "263-462", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Falls back from NPU to GPU for unsupported model types, sets NPU_TURBO for detection models, and recreates the infer_request per call for ArcFace because reused request state pollutes face embedding results."}, {"id": "detectors_detection_runners_openvino_lock", "label": "_OPENVINO_LOCK", "file_type": "code", "source_file": "frigate/detectors/detection_runners.py", "source_location": "18-19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Process-wide lock serializing every OpenVINO compile and inference call, covering both the shared-runner JinaV2 case and distinct runners on separate threads such as the ArcFace face-model build versus the LPR detector."}, {"id": "detectors_detection_runners_rknnmodelrunner", "label": "RKNNModelRunner", "file_type": "code", "source_file": "frigate/detectors/detection_runners.py", "source_location": "465-576", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Infers input names and widths from the model filename because RKNN blobs carry no usable metadata, transposes NCHW to NHWC, and de-normalizes ArcFace input back to uint8 since the RKNN runtime applies mean/std internally."}, {"id": "detectors_detection_runners_is_openvino_gpu_npu_available", "label": "is_openvino_gpu_npu_available", "file_type": "code", "source_file": "frigate/detectors/detection_runners.py", "source_location": "76-89", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "detectors_detection_runners_get_optimized_runner", "target": "detectors_detection_runners_rknnmodelrunner", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frigate/detectors/detection_runners.py", "source_location": "589", "w